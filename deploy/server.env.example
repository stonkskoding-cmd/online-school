# Шаблон переменных окружения бэкенда на VPS.
# Скопировать в /var/www/dinastiy/server/.env и подставить реальные значения.
# РЕАЛЬНЫЕ СЕКРЕТЫ СЮДА НЕ КОММИТИМ — только на сервере.

NODE_ENV=production
PORT=10000

# --- База данных Supabase (остаётся прежней, данные не переносим) ---
# Пул (PgBouncer, 6543) — для приложения:
DATABASE_URL=postgresql://postgres.<ref>:<db_pass>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Прямое подключение (5432) — для миграций Prisma:
DIRECT_URL=postgresql://postgres.<ref>:<db_pass>@db.<ref>.supabase.co:5432/postgres

# --- Безопасность (при передаче проекта — сгенерировать новые) ---
JWT_SECRET=<длинная_случайная_строка>
ADMIN_USERNAME=dinastia_admin
ADMIN_PASSWORD=<пароль_админки>

# --- Домен (один адрес: и фронт, и API через nginx) ---
FRONTEND_URL=https://dinastiy.com
BACKEND_URL=https://dinastiy.com

# --- ЮKassa (боевые ключи) ---
YOOKASSA_SHOP_ID=1412335
YOOKASSA_SECRET_KEY=<боевой_секретный_ключ>
