# Шаблон client/.env.production для сборки фронтенда НА VPS.
# ВНИМАНИЕ: в репозитории client/.env.production по-прежнему указывает на Render —
# не меняем его до переключения, чтобы не сломать текущий рабочий сайт.
# На сервере перед `npm run build` создаём client/.env.production с этими значениями.

# Один домен: API и сокеты идут через nginx на тот же dinastiy.com
VITE_API_URL=https://dinastiy.com/api
VITE_SOCKET_URL=https://dinastiy.com

# Supabase (хранилище файлов) — остаётся прежним
VITE_SUPABASE_URL=https://ixtslzpsogyzynrbkbrl.supabase.co
VITE_SUPABASE_ANON_KEY=<тот_же_anon_key_что_сейчас>
